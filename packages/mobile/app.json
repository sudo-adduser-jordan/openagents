{
	"expo": {
		"name": "Open Agents",
		"slug": "open-agents-mobile",
		"version": "1.3.1",
		"runtimeVersion": {
			"policy": "fingerprint"
		},
		"orientation": "portrait",
		"icon": "./assets/icon.png",
		"userInterfaceStyle": "automatic",
		"backgroundColor": "#0a0b0d",
		"scheme": "open-agents-mobile",
		"ios": {
			"icon": "./assets/open-agents.icon",
			"supportsTablet": true,
			"bundleIdentifier": "dev.openagents.mobile",
			"config": {
				"usesNonExemptEncryption": false
			},
			"privacyManifests": {
				"NSPrivacyTracking": false,
				"NSPrivacyCollectedDataTypes": [
					{
						"NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeProductInteraction",
						"NSPrivacyCollectedDataTypeLinked": false,
						"NSPrivacyCollectedDataTypeTracking": false,
						"NSPrivacyCollectedDataTypePurposes": ["NSPrivacyCollectedDataTypePurposeAnalytics"]
					},
					{
						"NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeDeviceID",
						"NSPrivacyCollectedDataTypeLinked": false,
						"NSPrivacyCollectedDataTypeTracking": false,
						"NSPrivacyCollectedDataTypePurposes": ["NSPrivacyCollectedDataTypePurposeAppFunctionality"]
					}
				]
			},
			"infoPlist": {
				"NSLocalNetworkUsageDescription": "Open Agents connects to the Open Agents daemon running on your computer over your local network.",
				"NSPhotoLibraryUsageDescription": "Open Agents uses your photo library so you can attach images to an agent conversation.",
				"NSAppTransportSecurity": {
					"NSAllowsLocalNetworking": true
				},
				"LSApplicationQueriesSchemes": ["github"]
			}
		},
		"android": {
			"package": "dev.openagents.mobile",
			"googleServicesFile": "./google-services.json",
			"adaptiveIcon": {
				"backgroundImage": "./assets/android-icon-background.png",
				"foregroundImage": "./assets/android-icon-foreground.png",
				"monochromeImage": "./assets/android-icon-monochrome.png"
			},
			"predictiveBackGestureEnabled": true,
			"permissions": ["android.permission.CAMERA"],
			"softwareKeyboardLayoutMode": "resize"
		},
		"web": {
			"favicon": "./assets/favicon.png",
			"bundler": "metro"
		},
		"plugins": [
			"expo-router",
			[
				"expo-build-properties",
				{
					"android": {
						"usesCleartextTraffic": true
					}
				}
			],
			[
				"expo-camera",
				{
					"cameraPermission": "Allow Open Agents to scan the pairing QR code.",
					"recordAudioAndroid": false
				}
			],
			[
				"expo-image-picker",
				{
					"photosPermission": "Allow Open Agents to attach images to agent conversations."
				}
			],
			"expo-document-picker",
			[
				"expo-speech-recognition",
				{
					"microphonePermission": "Allow Open Agents to use the microphone so you can dictate prompts to an agent.",
					"speechRecognitionPermission": "Allow Open Agents to transcribe your speech into prompts for an agent."
				}
			],
			[
				"expo-notifications",
				{
					"color": "#4d8dff"
				}
			],
			"expo-secure-store",
			"expo-status-bar",
			"expo-font",
			[
				"expo-splash-screen",
				{
					"image": "./assets/splash-icon.png",
					"resizeMode": "contain",
					"backgroundColor": "#0a0b0d"
				}
			]
		],
		"extra": {
			"router": {}
		},
		"owner": "sudo-adduser-jordan"
	}
}
