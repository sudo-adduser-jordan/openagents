      "boundElements": null,
      "updated": 1790402527934,
      "link": null,
      "locked": false,
      "text": "A failed probe is not proof\nof death. A session terminates only\nwhen runtime and process are both\nclearly dead and recent activity\ndoes not contradict it.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A failed probe is not proof\nof death. A session terminates only\nwhen runtime and process are both\nclearly dead and recent activity\ndoes not contradict it.",
      "autoResize": true,
      "lineHeight": 1.15
    },
