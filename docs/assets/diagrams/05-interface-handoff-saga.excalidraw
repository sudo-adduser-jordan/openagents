    {
      "id": "01TFnyf7_cAKp62eJV_bG",
      "type": "text",
      "x": 764,
      "y": 937.5,
      "width": 500.50000000000006,
      "height": 44.849999999999994,
      "angle": 0,
      "strokeColor": "#663c00",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "GrmrT8SvBgXCOqheD38oZ",
      "index": "b0D",
      "roundness": null,
      "seed": 77827568,
      "version": 2,
      "versionNonce": 2014585328,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790398466412,
      "link": null,
      "locked": false,
      "text": "Cancelled at acceptance leaves the source untouched: everything before\nthe commit point is reversible, and the dispatch fence stops a queued\ncompletion from being promoted while the target is still preflighting.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Cancelled at acceptance leaves the source untouched: everything before\nthe commit point is reversible, and the dispatch fence stops a queued\ncompletion from being promoted while the target is still preflighting.",
      "autoResize": true,
      "lineHeight": 1.15
    },
