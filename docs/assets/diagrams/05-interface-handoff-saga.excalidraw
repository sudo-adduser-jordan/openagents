      "type": "text",
      "x": 1404,
      "y": 177.5,
      "width": 214.50000000000003,
      "height": 74.75,
      "angle": 0,
      "strokeColor": "#3b2a7a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
