      "isDeleted": false,
      "boundElements": null,
      "updated": 1790402527980,
      "link": null,
      "locked": false,
      "text": "Messages that arrive while no\ncontroller is live wait in a\ndurable outbox, delivered\nthrough whichever controller ends\nup owning the session.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Messages that arrive while no\ncontroller is live wait in a\ndurable outbox, delivered\nthrough whichever controller ends\nup owning the session.",
      "autoResize": true,
      "lineHeight": 1.15
    },
