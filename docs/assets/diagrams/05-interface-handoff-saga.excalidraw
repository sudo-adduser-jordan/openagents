      "link": null,
      "locked": false,
      "text": "A drain may wait indefinitely on\nan approval. An unverified idle\nsurface has a bounded proof\nwindow; a visible draft fails\nwith the source untouched.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A drain may wait indefinitely on\nan approval. An unverified idle\nsurface has a bounded proof\nwindow; a visible draft fails\nwith the source untouched.",
