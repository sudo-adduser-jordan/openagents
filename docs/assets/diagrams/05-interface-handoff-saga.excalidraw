      "isDeleted": false,
      "boundElements": null,
      "updated": 1790402527980,
      "link": null,
      "locked": false,
      "text": "Old Chat events are fenced by\ncontroller generation. Old TUI\nhooks are fenced by runtime\nlaunch id. Neither can be\nmistaken for the new owner.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Old Chat events are fenced by\ncontroller generation. Old TUI\nhooks are fenced by runtime\nlaunch id. Neither can be\nmistaken for the new owner.",
      "autoResize": true,
      "lineHeight": 1.15
    },
