      "isDeleted": false,
      "boundElements": null,
      "updated": 1790398466280,
      "link": null,
      "locked": false,
      "text": "Automation may inject input into waiting_input — that is an agent sitting\nat an empty prompt. It must never inject into blocked, which is an agent\nstopped on a permission decision only a human can make.",
      "fontSize": 14,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Automation may inject input into waiting_input — that is an agent sitting\nat an empty prompt. It must never inject into blocked, which is an agent\nstopped on a permission decision only a human can make.",
      "autoResize": true,
      "lineHeight": 1.15
    },
